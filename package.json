{
  "name": "promax-presenter",
  "productName": "ProMax Presenter",
  "version": "1.3.0",
  "description": "Complete worship presentation app with meetings, Bible, YouTube and offline motion backgrounds",
  "author": "ProMax Presenter",
  "private": true,
  "license": "UNLICENSED",
  "main": "desktop/main.js",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "start": "electron .",
    "start:browser": "node server.js",
    "test": "node --test test/*.test.cjs tests/*.test.js",
    "test:desktop": "node test/recovered-desktop.cjs",
    "dist": "electron-builder --win nsis --x64 --publish never",
    "dist:release": "node scripts/build-release.cjs",
    "test:shared": "node test/shared-desktop.cjs",
    "test:visuals": "node test/visual-library-desktop.cjs",
    "verify": "electron . --smoke-test --feature-test --release-test",
    "test:backup": "node tests/backup-roundtrip.cjs",
    "test:private": "node test/private-content-browser.cjs"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "electron": "44.9.1",
    "electron-builder": "26.15.3",
    "playwright": "1.64.1"
  },
  "overrides": {
    "@electron/get": "5.1.0"
  },
  "build": {
    "appId": "com.promax.presenter",
    "productName": "ProMax Presenter",
    "copyright": "Copyright © 2026 ProMax Presenter",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "desktop/**",
      "build/icon.ico",
      "*.html",
      "*.js",
      "*.css",
      "shared-config.json",
      "visuals/*.svg",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "ProMax-Presenter-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    },
    "publish": null,
    "asarUnpack": [
      "**/*.ps1"
    ]
  }
}
